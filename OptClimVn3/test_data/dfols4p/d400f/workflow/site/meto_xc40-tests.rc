    [[ROSE_ANA_RESOURCE]]
        inherit = HPC_SERIAL
        execution time limit = PT10M

    [[UMBUILD_NOOMP]]
        inherit = UMBUILD
        [[[environment]]]
            OPENMP= false
            PREBUILD = {{PREBUILDS}}/fcm_make_meto_xc40_cce_um_safe_noomp

    [[ATMOS_TEST_RESOURCE]]
        inherit = ATMOS_RESOURCE
        execution time limit = {{MAIN_CLOCK}}

    [[ATMOS_NCRUN_RESOURCE]]
        inherit = ATMOS_RESOURCE
        execution time limit = {{NCRUN_CLOCK}}

{% if TEST_PE %}
  {% set PE_APPN = PE_ATM_PPN if PE_ATM_PPN is defined else PPN %}
  {% set PE_TASKS_ATM = PE_ATM_PROCX * PE_ATM_PROCY + PE_IOS_NPROC %}
  {% set PE_NODE_ATM = node(PE_TASKS_ATM, PE_OMPTHR_ATM, PE_HYPTHR_ATM, CORES_PER_NODE) %}
  {% set PE_TPNUMA_ATM = tpnuma(PE_OMPTHR_ATM, PE_HYPTHR_ATM, CORES_PER_NODE) %}
    [[ATMOS_PE_RESOURCE]]
        inherit = ATMOS_TEST_RESOURCE
        [[[directives]]]
            -l select={{PE_NODE_ATM}}:ncpus={{CORES_PER_NODE}}:coretype={{CORE_XC40}}:subproject={{SUBPROJECT}}:funding={{FUNDING}}
        [[[environment]]]
            ROSE_LAUNCHER_PREOPTS = -ss -n {{PE_TASKS_ATM}} -cc numa_node -N {{2*(PE_TPNUMA_ATM|int)}} -S {{PE_TPNUMA_ATM}} -d {{PE_OMPTHR_ATM}} -j {{PE_HYPTHR_ATM}}
{% endif %}

{% if TEST_OMP %}
  {% set OMP_APPN = OMP_ATM_PPN if OMP_ATM_PPN is defined else PPN %}
  {% set OMP_TASKS_ATM = OMP_ATM_PROCX * OMP_ATM_PROCY + OMP_IOS_NPROC %}
  {% set OMP_NODE_ATM = node(OMP_TASKS_ATM, OMP_OMPTHR_ATM, OMP_HYPTHR_ATM, CORES_PER_NODE) %}
  {% set OMP_TPNUMA_ATM = tpnuma(OMP_OMPTHR_ATM, OMP_HYPTHR_ATM, CORES_PER_NODE) %}
    [[ATMOS_OMP_RESOURCE]]
        inherit = ATMOS_TEST_RESOURCE
        [[[directives]]]
            -l select={{OMP_NODE_ATM}}:ncpus={{CORES_PER_NODE}}:coretype={{CORE_XC40}}:subproject={{SUBPROJECT}}:funding={{FUNDING}}
        [[[environment]]]
            ROSE_LAUNCHER_PREOPTS = -ss -n {{OMP_TASKS_ATM}} -cc numa_node -N {{2*(OMP_TPNUMA_ATM|int)}} -S {{OMP_TPNUMA_ATM}} -d {{OMP_OMPTHR_ATM}} -j {{OMP_HYPTHR_ATM}}
{% endif %}

{% if TEST_NOOMP %}
    [[ATMOS_NOOMP_RESOURCE]]
        inherit = ATMOS_TEST_RESOURCE
        [[[environment]]]
            ROSE_LAUNCHER_PREOPTS = -ss -n {{TASKS_ATM}} -cc numa_node -N {{2*(TPNUMA_ATM|int)}} -S {{TPNUMA_ATM}}
{% endif %}

    [[MULE_RESOURCE]]
        pre-script = """
            module load scitools/production-os45-1
            module load um_tools/2023.08.1/no-openmp
            module list 2>&1
            export ROSE_PYTHONPATH=$PYTHONPATH
        """

    [[INCS_TEST_RESOURCE]]
        inherit = HPC_SERIAL
        execution time limit = PT20M
        [[[directives]]]
            -l mem=5GB
