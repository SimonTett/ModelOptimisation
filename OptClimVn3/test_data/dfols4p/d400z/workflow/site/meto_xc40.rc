{% set CORES_PER_NODE = 32 if (CORE_XC40 == 'haswell') else 36 if ( CORE_XC40 == 'broadwell') %}

{# Macro to calculate number of tasks per NUMA region on a node based on #}
{# OpenMP threads, hyperthreads and number of cores per node. #}
{%- macro tpnuma(o,h,pn) -%}
  {{ ((h*pn)/(2*o)) | round (0, 'ceil') | int }}
{%- endmacro -%}


{% set TASKS_RCF = MAIN_RCF_PROCX * MAIN_RCF_PROCY %}
{% set TASKS_ATM = MAIN_ATM_PROCX * MAIN_ATM_PROCY + MAIN_IOS_NPROC %}
{% set NODE_RCF = node(TASKS_RCF, 1, 1, CORES_PER_NODE) %}
{% set NODE_ATM = node(TASKS_ATM, MAIN_OMPTHR_ATM, MAIN_HYPTHR_ATM, CORES_PER_NODE) %}
{% set TPNUMA_RCF = tpnuma(1, 1, CORES_PER_NODE) %}
{% set TPNUMA_ATM = tpnuma(MAIN_OMPTHR_ATM, MAIN_HYPTHR_ATM, CORES_PER_NODE) %}

{% set SUBPROJECT = METO_SUBPROJECT_OTHER if METO_SUBPROJECT == 'other' else METO_SUBPROJECT %}
{% set FUNDING = METO_FUNDING_OTHER if METO_FUNDING == 'other' else METO_FUNDING %}

{% set PREBUILDS = '/home/d05/frum/cylc-run/vn11.4_prebuilds/share' %}

    [[RETRIES]]
        execution retry delays = 2*PT30M, 2*PT1H, PT3H, 3*PT6H

    [[LINUX]]
        platform = localhost
        [[[environment]]]
            PLATFORM = linux
            UMDIR = ~frum

    [[SPICE]]
        platform = spice
        [[[directives]]]
            --qos = 'normal'

    [[EXTRACT_RESOURCE]]
        execution time limit = PT5M
        [[[directives]]]
            --mem=1G
            --ntasks=1

    [[HPC]]
        platform = {{HOST_XC40}}
        pre-script = module load cray-netcdf
        submission retry delays = 2*PT30S,PT5M,PT15M,PT30M,PT1H
        [[[directives]]]
            -W umask=0022
            {% if not METO_ACCOUNT_DEFAULT %}
            -P = {{METO_ACCOUNT_OTHER if METO_ACCOUNT == 'other' else METO_ACCOUNT}}
            {% endif %}
        [[[environment]]]
            PLATFORM = xc40
            UMDIR = /projects/um1
            CMIP6_ANCILS = /projects/ancils/cmip6/ancils
	    CORE_DUMPS_DIR = /data/d02/ukesm/restarts/

    [[HPC_SERIAL]]
        inherit = HPC
        [[[directives]]]
            -l ncpus=1
            -q=shared
        [[[environment]]]
            ROSE_TASK_N_JOBS = 1

    [[HPC_SHARED6]]
        inherit = HPC
        [[[directives]]]
            -l ncpus=6
            -q=shared
        [[[environment]]]
            ROSE_TASK_N_JOBS = 6

    [[UMBUILD]]
        [[[environment]]]
            CONFIG = meto-xc40-cce
            OPENMP= true
            OPTIM = safe
            PREBUILD = {{PREBUILDS}}/fcm_make_meto_xc40_cce_um_safe_omp

    [[UMBUILD_RESOURCE]]
        inherit = HPC_SHARED6
        script = {{TASK_RUN_COMMAND + " --define='fast-dest-root-orig=$RAMTMP' --define='args=--archive'"}}
        execution time limit = PT60M
        [[[directives]]]
            -l mem=6GB
            -l tmpsize=6GB

    [[INSTALL_RESOURCE]]
        inherit = HPC_SERIAL
        execution time limit = PT1M

    [[UM_PARALLEL]]
        inherit = HPC
        [[[directives]]]
            -q={{METO_QUEUE}}
        [[[environment]]]
            MPICH_COLL_SYNC = MPI_Gatherv
            MPICH_GNI_MAX_EAGER_MSG_SIZE = 65536
            MPICH_GNI_MAX_VSHORT_MSG_SIZE = 8192
            MPICH_MAX_THREAD_SAFETY = multiple
            OMP_STACKSIZE = 2G
            ROSE_LAUNCHER = aprun

    [[RCF_RESOURCE]]
        inherit = UM_PARALLEL
	execution time limit = PT10M
        [[[directives]]]
            -l select={{NODE_RCF}}:ncpus={{CORES_PER_NODE}}:coretype={{CORE_XC40}}:subproject={{SUBPROJECT}}:funding={{FUNDING}}
        [[[environment]]]
            ROSE_LAUNCHER_PREOPTS = -ss -n {{TASKS_RCF}} -N {{2*(TPNUMA_RCF|int)}} -S {{TPNUMA_RCF}} -d 1
            ROSE_LAUNCHER_ULIMIT_OPTS = -s unlimited -c unlimited

    [[ATMOS_RESOURCE]]
        inherit = UM_PARALLEL
	execution time limit = {{MAIN_CLOCK}}
        [[[directives]]]
            -l select={{NODE_ATM}}:ncpus={{CORES_PER_NODE}}:coretype={{CORE_XC40}}:subproject={{SUBPROJECT}}:funding={{FUNDING}}
        [[[environment]]]
            ROSE_LAUNCHER_PREOPTS = -ss -n {{TASKS_ATM}} -cc numa_node -N {{2*(TPNUMA_ATM|int)}} -S {{TPNUMA_ATM}} -d {{MAIN_OMPTHR_ATM}} -j {{MAIN_HYPTHR_ATM}}

    [[PPBUILD_RESOURCE]]
        inherit = HPC_SERIAL
        execution time limit = PT5M

    [[POSTPROC_RESOURCE]]
        inherit = HPC_SERIAL, RETRIES
        pre-script = module load um_tools moose-client-wrapper
	execution retry delays = PT10M, PT1H, PT3H, P1D
        execution time limit = PT3H
        [[[directives]]]
            -l mem = 70GB
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = {{ 'duplex' if METO_ARCHIVE_DUPLEX else '' }}

    # for completeness, different settings for Transform and Archive
    # on Meto_EX
    [[POSTPROC_TRANSFORM_RESOURCE]]
        inherit = POSTPROC_RESOURCE

    [[POSTPROC_ARCHIVE_RESOURCE]]
        inherit = POSTPROC_RESOURCE

    [[PPTRANSFER_RESOURCE]]
        inherit = HPC_SERIAL
        pre-script = module load scitools/production_legacy-os42-1
        execution time limit = PT1H

    [[SUPERMEAN_RESOURCE]]
        inherit = SPICE, RETRIES
        execution retry delays = PT1H
        execution time limit = PT2H
        [[[directives]]]
            --mem-per-cpu = 2048
            --ntasks = 1
	[[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = {{"azspice" if ROSE_ORIG_HOST[0:3] == "caz" else ""}}
	    
    [[LOGS_RESOURCE]]
        inherit = LINUX, RETRIES

    [[WALLCLOCK_RESOURCE]]
        inherit = HPC_SERIAL, RETRIES
        pre-script = module load moose-client-wrapper
        execution time limit = PT2M

    [[HOUSEKEEP_RESOURCE]]
        inherit = LINUX

{% if TASK_RUN and TASK_TESTS %}
  {% include 'site/meto_xc40-tests.rc' %}
{% endif %}
