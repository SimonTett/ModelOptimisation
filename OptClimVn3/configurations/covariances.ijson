        "file_comment": "Name of file containing Covariance Matrix of Internal Variability",
        "diagonalize": false,
        "diagonalize_comment": "If true diagonalise the  covariance matrix"
    },
    "CovIntVar_Comment": "How to generate Covariance Matrix for Internal Variability",
    "CovObsErr": {
        "file": "$OPTCLIMTOP/covariance/cov_obserr_20.csv",
        "file_comment": "Name of file containing Covariance Matrix for Observational Error ",
