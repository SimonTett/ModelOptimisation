{
    "comment": "Covariance matrices and operations on them. If CovObsErr and CovIntVar are *both* specified then CovTotal will be computed from them if its path is null. If only one of CovObsErr and CovIntVar is specified then CovTotal must be specified. If CovTotal is specified then CovObsErr and CovIntVar are not used in its computation which could lead to inconsistency.",
    "CovTotal": {
        "file": null,
        "file_comment": "Name of file containing Covariance Matrix for total Error. If null then covariance computed from CovIntVar and CovObsErr.",
        "diagonalize": false,
        "diagonalize_comment": "If true diagonalise the covariance matrix",
        "importance_scaling": null,
        "importance_scaling_comment": "If not null then dict of scaling factors for importance scaling. Keys should be observation names and values should be scaling factors. More is less important.  ",
        "example_importance_scaling_comment": {
            "netflux_global": 0.5,
            "netflux_global_comment": "1/2 error on netflux_global to make it more important in optimisation"
        }
    },
    "CovTotal_Comment": "How to generate Covariance Matrix for total Error.",
    "CovIntVar": {
