{
	"_comment":"configuration for logging. See https://docs.python.org/3.9/library/logging.config.html#logging-config-dictschema. Use INCLUDE pathname to include in a config.",
	"history_comment":"This version generated August 2023 by SFBT. Updated Oct 2026 to add secure logs",
	    "version": 1,
	    "formatters": {
		"std": {
		    "format": "%(levelname)s:%(name)s:%(funcName)s: %(message)s",
		    "validate": true
		},
		"brief": {
		    "format": "%(levelname)s:%(name)s:  %(message)s",
		    "validate": true
		}
	    },
	    "formatters_comment":"Control formatting output",
	    "handlers": {
		"console": {
		    "class": "logging.StreamHandler",
		    "formatter": "std"
		},
		"consoleBrief": {
		    "class": "logging.StreamHandler",
		    "formatter": "brief"
		},
		"secureFile": {
		    "class": "logging.FileHandler",
		    "filename": "$OPTCLIM_LOG_DIR/secure.log",
		    "formatter": "std"
		},
		"dfolsFile": {
		    "class": "logging.FileHandler",
		    "filename": "$OPTCLIM_LOG_DIR/dfols.log",
		    "formatter": "std"
		},
		"dfolsConsole": {
		    "class": "logging.StreamHandler",
		    "stream": "ext://sys.stderr",
		    "formatter": "std"
		}
	    },
	    "handlers_comment":"Control handlers",
	    "loggers": {
		"OPTCLIM": {
		    "level": "WARNING",
		    "propagate": false,
		    "handlers": ["console"]
		},
		"OPTCLIM.generic_json": {
		    "level": "WARNING",
		    "handlers":["consoleBrief"]
		},
		"OPTCLIM.security": {
		    "level": "INFO",
		    "propagate": false,
		    "handlers": ["secureFile", "consoleBrief"]
		},
		"dfols": {
		    "level": "INFO",
		    "propagate": false,
		    "handlers": ["dfolsFile", "dfolsConsole"]
		}
	    },
	    "mkdir": true,
	    "loggers_comment":"Routes security warnings and DFOLS output to dedicated files and stderr."
	}