#!jinja2

{# Define known sites #}
{% set KNOWN_SITE_CFGS = ['archer2', 'meto_ex', 'meto_xc40', 'monsoon', 'nci_raijin', 'niwa_cray'] %}
{# Comment out the following test until assert (introduced at cylc-7.2.0) works at all sites:
{{ assert(SITE in KNOWN_SITE_CFGS, "Site not recognised") }}
#}

{# Macro to calculate number of nodes required based on total tasks, #}
{# OpenMP threads, hyperthreads and number of cores per node #}
{%- macro node(t,o,h,pn) -%}
  {{ ((t*o)/(h*pn)) | round (0, 'ceil') | int }}
{%- endmacro -%}

{# Macro to calculate number of tasks per node based on #}
{# OpenMP threads, hyperthreads and number of cores per node. #}
{%- macro tpnode(o,h,pn) -%}
  {{ ((h*pn)/o) | round (0, 'ceil') | int }}
{%- endmacro -%}

{# Set default task run command to optionally use site specific opt configs #}
{% set TASK_RUN_COMMAND = "rose task-run --verbose -O '(" + SITE + ")'" %}

{# Command for UM must make sure using main executable #}
{% set UM_TASK_RUN_COMMAND = TASK_RUN_COMMAND ~ ' --path="share/fcm_make_um/build-*/bin"' %}

{# Set rose date command and associated print-format options #}
{% set ROSEDATE = "rose date -c --calendar=360day" %}
{% set PFMT_YR = "--print-format='%Y'" %}
{% set PFMT_MONTH = "--print-format='%Y%b'" %}
{% set PFMT_DUMP = "--print-format='%Y%m%d_%H'" %}
{% set PFMT_UM_PT = "--print-format='%Y,%m,%d,%H,%M,%S'" %}
{% set PFMT_UM_DUR = "--print-format='y,m,d,h,M,s'" %}
{% if BASIS[0] == 0 %}
  {% set CYCLE_INIT = '00000101' %}
{% else %}
  {% set CYCLE_INIT = '%04d%02d%02dT%02d%02d' % (BASIS[0],BASIS[1],BASIS[2],BASIS[3],BASIS[4]) %}
{% endif %}

{% set BITCOMP_NRUN_OPT = 'bitcomp' if BITCOMP_NRUN else '' %}

{% set MAIN_RCF_PROCX = MAIN_RCF_PROCX if MAIN_RCF_PROCX is defined else 1 %}
{% set MAIN_RCF_PROCY = MAIN_RCF_PROCY if MAIN_RCF_PROCY is defined else 1 %}

{# Site or machine specific options #}
{% set EXZ_KEY = 'exz' if HOST_EX is defined and HOST_EX == 'exz' else '' %}
{% set L_REMOTE_SETUP = true if SITE == 'archer2' else false %}
{% set POSTPROC_2STEP = true if SITE == 'meto_ex' else false %}
{% set TASK_ARCHIVE_INTEGRITY = TASK_ARCHIVE_INTEGRITY if TASK_ARCHIVE_INTEGRITY is defined else false %}
{% set TASK_ARCH_LOG = TASK_ARCH_LOG if TASK_ARCH_LOG is defined else false %}
{% set TASK_ARCH_WALL = TASK_ARCH_WALL if TASK_ARCH_WALL is defined else false %}
{% set TASK_JDMA = TASK_JDMA if TASK_JDMA is defined else false %}
{% set TASK_PPTRANSFER = TASK_PPTRANSFER if TASK_PPTRANSFER is defined else false %}
{% set TASK_SUPERMEAN = TASK_SUPERMEAN if TASK_SUPERMEAN is defined else false %}
{% set TEST_CRUN = TEST_CRUN if TEST_CRUN is defined else false %}
{% set TEST_INCS = TEST_INCS if TEST_INCS is defined else false %}
{% set TEST_NOOMP = TEST_NOOMP if TEST_NOOMP is defined else false %}
{% set TEST_NOSTASH = TEST_NOSTASH if TEST_NOSTASH is defined else false %}
{% set TEST_NRUN = TEST_NRUN if TEST_NRUN is defined else false %}
{% set TEST_OMP = TEST_OMP if TEST_OMP is defined else false %}
{% set TEST_PE = TEST_PE if TEST_PE is defined else false %}

{# Test to determine when to use single fcm_make_um task #}
{% set SINGLE_FCMUM = ['meto_ex', 'meto_xc40', 'niwa_cray'] %}
{% if SITE in SINGLE_FCMUM %}
  {% set FCMUM_GRAPH = 'fcm_make_um' %}
{% else %}
  {% set FCMUM_GRAPH = 'fcm_make_um => fcm_make2_um' %}
{% endif %}

[scheduler]
    UTC mode = True
    [[events]]
        mail events = shutdown

[scheduling]
    cycling mode            = 360day
    initial cycle point     = {{CYCLE_INIT}}
    stop after cycle point  = +{{EXPT_RUNLEN}}-PT1S
    runahead limit          = P3

    [[graph]]
       R1 = """
{% if L_REMOTE_SETUP %}
  {# Some HPCs require some remote setup before running other tasks. #}
  {{ 'remote_setup => install_ancil' if TASK_RUN else '' }}
  {{ 'remote_setup => fcm_make_um' if TASK_BUILD_UM else '' }}
  {{ 'remote_setup => fcm_make_pp' if TASK_POSTPROC else '' }}
{% endif %}
{% if TASK_POSTPROC %}
  {{ 'fcm_make_pp => fcm_make2_pp' }}
  {% if TASK_RUN and TASK_JDMA %}
    {{ 'fcm_make_pp_archive_host => fcm_make2_pp_archive_host => jdma' }}
  {% endif %}
{% endif %}
{{ FCMUM_GRAPH + (' => recon' if TASK_RECON else ' => atmos_main' if TASK_RUN else '') if TASK_BUILD_UM else '' }}
{{ 'install_ancil => recon ' if TASK_RECON else ('install_ancil => atmos_main' if TASK_RUN else '')}}
{% if TASK_RUN %}
  {{ 'recon => atmos_main' if TASK_RECON else '' }}
{% endif %}
"""

        {{EXPT_RESUB}} = """
{% if TASK_RUN %}
atmos_main[-{{EXPT_RESUB}}] => atmos_main
  {% if TASK_POSTPROC %}
    {% if POSTPROC_2STEP %}
=> postproc_transform => postproc_archive
    {% else %}
=> postproc
    {% endif %}
    {% if TASK_PPTRANSFER %}
=> pptransfer {{ (' => jdma' if TASK_JDMA else '') }}
    {% endif %}
  {% endif %}
  {% if TASK_SUPERMEAN %}
=> supermean
  {% endif %}
  {% if TASK_ARCH_LOG %}
=> rose_arch_logs
  {% endif %}
  {% if TASK_HOUSEKEEP %}
=> housekeeping
  {% endif %}
  {% if TASK_POSTPROC %}
    {% if POSTPROC_2STEP %}
postproc_archive[-{{EXPT_RESUB}}] => postproc_transform
    {% else %}
postproc[-{{EXPT_RESUB}}] => postproc
    {% endif %}
    {% if TASK_PPTRANSFER %}
pptransfer[-{{EXPT_RESUB}}] => pptransfer
    {% endif %}
  {% endif %}
{% endif %}
"""

{% if TASK_RUN and TASK_ARCH_WALL %}
        R1//^+{{EXPT_RUNLEN}}-{{EXPT_RESUB}} = atmos_main => rose_arch_wallclock => housekeeping
{% endif %}

{# Include tests graph if required #}
{% if TASK_TESTS %}
  {% include 'tests-graph.rc' %}
{% endif %}

[runtime]
    [[root]]
        script = {{TASK_RUN_COMMAND}}
        env-script = "eval $(rose task-env)"
        [[[environment]]]
            {# Logicals for decision making based on initial cycle #}
            IS_CYLC_WORKFLOW_INITIAL_CYCLE_POINT = $(if [ $CYLC_TASK_CYCLE_POINT == $CYLC_WORKFLOW_INITIAL_CYCLE_POINT ]; then echo "true"; else echo "false"; fi)
            IS_CYLC_TASK_TRY_NUMBER_1 = $(if [ $CYLC_TASK_TRY_NUMBER -eq 1 ]; then echo "true"; else echo "false"; fi)
            {# Dates used in apps #}
            BASIS_UM_PT = $(rose date --print-format='%Y,%m,%d,%H,%M,%S' {{CYCLE_INIT}})
            BASIS_YR = $(rose date --print-format='%Y' {{CYCLE_INIT}})

            DATEC_DUMP = $({{ROSEDATE}} {{PFMT_DUMP}})
            {# RUNID for file names used in UM, postproc and rose_ana apps  #}
            {# Set up the runid which controls the first five characters of #}
            {# the output filenames. This can either be the final five      #}
            {# characters of the suite id or RUNID_USR as set by the user.  #}
            {% if RUNID %}
            RUNID = $(echo -n $CYLC_WORKFLOW_NAME | cut -d - -f 2 | cut -c 1-5)
            {% else %}
            RUNID = {{RUNID_USR}}
            {% endif %}
            {# UM version being used, required in postproc app #}
            UM_VN = {{VN}}
        [[[events]]]
            mail events = submission retry, retry, submission failed, failed, submission timeout, timeout
            submission timeout = P1D

    [[UM]]
        script = {{UM_TASK_RUN_COMMAND}}
        [[[environment]]]
            FLUME_IOS_NPROC = {{MAIN_IOS_NPROC}}
            RCF_NPROCX = {{MAIN_RCF_PROCX}}
            RCF_NPROCY = {{MAIN_RCF_PROCY}}
            ROSE_APP_OPT_CONF_KEYS = {{BITCOMP_NRUN_OPT}}
            ROSE_TASK_APP = um
            UM_ATM_NPROCX = {{MAIN_ATM_PROCX}}
            UM_ATM_NPROCY = {{MAIN_ATM_PROCY}}

    [[RECONFIGURE]]
        inherit = UM
        [[[environment]]]
            TASKEND = $BASIS_UM_PT

    [[ATMOS]]
        inherit = UM
        [[[environment]]]
            HYPERTHREADS = {{MAIN_HYPTHR_ATM}}
            OMP_NUM_THREADS = {{MAIN_OMPTHR_ATM}}
            CONTINUE = $(if $IS_CYLC_WORKFLOW_INITIAL_CYCLE_POINT && $IS_CYLC_TASK_TRY_NUMBER_1; then echo "false"; else echo "true"; fi)
            TASKEND = $({{ROSEDATE}} {{PFMT_UM_DUR}} --offset2={{EXPT_RESUB}} {{CYCLE_INIT}} ref)

    [[RUN_MAIN]]
        [[[environment]]]
            DATAM = $ROSE_DATA/{{DATAM}}

{% if L_REMOTE_SETUP %}
    [[remote_setup]]
       inherit = None, REMOTE_SETUP_RESOURCE
       script = "echo 'Ensure suite dir set up correctly on remote host.'"
{% endif %}

{% if SITE in SINGLE_FCMUM %}
    [[fcm_make_um]]
        inherit = RUN_MAIN, UMBUILD_RESOURCE, UMBUILD
{% else %}
    [[fcm_make_um]]
        inherit = RUN_MAIN, EXTRACT_RESOURCE, UMBUILD
    [[fcm_make2_um]]
        inherit = RUN_MAIN, UMBUILD_RESOURCE, UMBUILD

{% endif %}

    [[install_ancil]]
        inherit = RUN_MAIN, INSTALL_RESOURCE
	[[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = {{EXZ_KEY}}

    [[recon]]
        inherit = RUN_MAIN, RCF_RESOURCE, RECONFIGURE

    [[atmos_main]]
        inherit = RUN_MAIN, ATMOS_RESOURCE, ATMOS
        post-script = save_wallclock.sh {{EXPT_RESUB}}

    [[fcm_make_pp]]
        inherit = RUN_MAIN, EXTRACT_RESOURCE
    [[fcm_make2_pp]]
        inherit = RUN_MAIN, PPBUILD_RESOURCE

    [[POSTPROC]]
        [[[environment]]]
            ARCHIVE_SET = $CYLC_WORKFLOW_NAME
            CYCLEPERIOD = {{EXPT_RESUB}}
            ROSE_TASK_APP = postproc

{% if POSTPROC_2STEP %}
    [[postproc_transform]]
        inherit = POSTPROC, POSTPROC_TRANSFORM_RESOURCE, RUN_MAIN
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = transform {{EXZ_KEY}}

    [[postproc_archive]]
        inherit = POSTPROC, POSTPROC_ARCHIVE_RESOURCE, RUN_MAIN
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = archive

{% else %}
    [[postproc]]
        inherit = POSTPROC, POSTPROC_RESOURCE, RUN_MAIN
{% endif %}

{% if TASK_PPTRANSFER %}
    [[pptransfer]]
        inherit = RUN_MAIN, PPTRANSFER_RESOURCE, POSTPROC

  {% if TASK_JDMA %}
    [[fcm_make_pp_archive_host]]
        inherit = None, EXTRACT_RESOURCE
        [[[environment]]]
            ROSE_TASK_APP = fcm_make_pp

    [[fcm_make2_pp_archive_host]]
        inherit = None, PPBUILD_RESOURCE_ARCHIVE_HOST
        [[[environment]]]
            ROSE_TASK_APP = fcm_make_pp

    [[jdma]]
        inherit = POSTPROC, JDMA_RESOURCE, RUN_MAIN

  {% endif %}
{% endif %}

{% if TASK_SUPERMEAN %}
    [[supermean]]
        inherit = RUN_MAIN, SUPERMEAN_RESOURCE
        [[[environment]]]
	    ARCHIVE_SET = $CYLC_WORKFLOW_NAME
            BASIS = {{CYCLE_INIT}}
            TCYCLE = $({{ROSEDATE}} ref)
            NCYCLE = $({{ROSEDATE}} --offset={{EXPT_RESUB}} ref)
{% endif %}

{% if TASK_ARCHIVE_INTEGRITY and TASK_POSTPROC %}
    [[archive_integrity]]
        inherit = POSTPROC, POSTPROC_ARCHIVE_RESOURCE, RUN_MAIN
        execution retry delays = 3*PT1H
        execution time limit = PT20M
        [[[environment]]]
            ROSE_TASK_APP = postproc
            ROSE_APP_COMMAND_KEY = verify
            ROSE_TASK_N_JOBS = 1
            CYCLEPERIOD = {{EXPT_RESUB}}
{% endif %}

{% if TASK_ARCH_LOG %}
    [[rose_arch_logs]]
        inherit = RUN_MAIN, LOGS_RESOURCE
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = logs
            ROSE_TASK_APP = rose_arch
{% endif %}

{% if TASK_ARCH_WALL %}
    [[rose_arch_wallclock]]
        inherit = RUN_MAIN, WALLCLOCK_RESOURCE
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = wallclock
            ROSE_TASK_APP = rose_arch
{% endif %}

    [[housekeeping]]
        inherit = RUN_MAIN, HOUSEKEEP_RESOURCE

{# Include site specific configurations #}
{% include 'site/'+SITE+'.rc' %}
{% if TASK_RUN and TASK_TESTS %}
  {% include 'tests-runtime.rc' %}
{% endif %}
